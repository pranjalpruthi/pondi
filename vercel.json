{
  "rewrites": [
    {
      "source": "/youtube-feed/:path*",
      "destination": "https://www.youtube.com/:path*"
    },
    {
      "source": "/api/calendar/:path*",
      "destination": "https://gcal.pranjal.work/calendar/:path*"
    },
    {
      "source": "/api/search-locations/:path*",
      "destination": "https://gcal.pranjal.work/search-locations/:path*"
    },
    {
      "source": "/api/calendar-by-coordinates/:path*",
      "destination": "https://gcal.pranjal.work/calendar-by-coordinates/:path*"
    },
    {
      "source": "/api/nocodb/:path*",
      "destination": "https://db.vrindavanam.org.in/:path*"
    },
    {
      "source": "/:path((?!api/|youtube-feed/|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
